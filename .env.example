# Copier ce fichier en .env.local et remplir les valeurs.

# --- Base de données (obligatoire) -------------------------------------------
# Chaîne de connexion Neon "pooled" (…-pooler.…neon.tech/…).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- URL publique (obligatoire en production) --------------------------------
# Utilisée dans les liens envoyés par email (réinitialisation de mot de passe).
# Sur Vercel, l'URL de production est détectée automatiquement si elle est absente.
APP_URL=https://suivi-horaire.example.com

# --- Fuseau horaire de l'entreprise (facultatif, défaut : Africa/Tunis) ------
# Détermine "aujourd'hui" et l'heure enregistrée lors des pointages.
# NEXT_PUBLIC_APP_TIME_ZONE=Africa/Tunis

# --- Emails (facultatif) ------------------------------------------------------
# Sans SMTP_HOST, les emails sont seulement affichés dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Suivi Horaire <no-reply@example.com>"

# --- OCR (facultatif) ---------------------------------------------------------
# Google Cloud Vision, plus précis sur l'écriture manuscrite. Sans clé : Tesseract local.
GOOGLE_VISION_API_KEY=

# --- Comptes démo (facultatif) ------------------------------------------------
# En développement, admin@demo.com / admin123 et employe@demo.com / employe123 sont créés.
# Ailleurs : SEED_DEMO=true ET DEMO_PASSWORD (8 caractères min.) pour les deux comptes.
# SEED_DEMO=true
# DEMO_PASSWORD=
